
@hostname = http://127.0.0.1
@port = 8080

### Create new account
POST {{hostname}}:{{port}}/accounts HTTP/1.1
Content-Type: "application/json"

{
    "owner": "testUserUni",
    "currency" : "USD"
}

### Get account by id
GET {{hostname}}:{{port}}/accounts/1 HTTP/1.1
Accept: "application/json"

### List accounts
GET {{hostname}}:{{port}}/accounts?page_id=1&page_size=15 HTTP/1.1
Accept: "application/json"

### Delete account by id
DELETE {{hostname}}:{{port}}/accounts/2 HTTP/1.1
Accept: "application/json"

### Create new user
POST {{hostname}}:{{port}}/users HTTP/1.1
Content-Type: "application/json"

{
    "username": "testUserUni",
    "password": "p@ssw0rd",
    "full_name": "Testoviy Iuser",
    "email": "test@gmail.com"
}